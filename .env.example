# Copy this file to .env and fill in your own values. Never commit .env.

# Salesforce Developer Edition (sandbox only, never an employer org)
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login

# Apollo
APOLLO_API_KEY=

# Firecrawl
FIRECRAWL_API_KEY=

# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# Research settings
CONFIDENCE_THRESHOLD=0.6
