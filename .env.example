# Copy this file to .env and fill in your own values. Never commit .env.

# Salesforce Developer Edition (sandbox only, never an employer org)
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login

# Apollo
APOLLO_API_KEY=

# Firecrawl
FIRECRAWL_API_KEY=

# AI model for research and drafting (Phases 5 and 7)
# LLM_PROVIDER can be "gemini" (free tier, the default) or "anthropic" (paid)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Model names change, so the exact model is chosen in Phase 5
GEMINI_MODEL=

# Optional: only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Research settings
CONFIDENCE_THRESHOLD=0.6
